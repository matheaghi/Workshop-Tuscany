<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CLI-bundle trengs bare for aspire publish/deploy, som ikke brukes her -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>c4d0102d-52c1-4270-b250-553b3707fbb8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TronderLeikan.API/TronderLeikan.API.csproj" />
    <ProjectReference Include="../TronderLeikan.DbMigrator/TronderLeikan.DbMigrator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.Valkey" Version="13.5.4" />
  </ItemGroup>

</Project>
